#!/usr/bin/env sh
# No-install launcher: adds the repository root to PYTHONPATH and runs the arena package
# Usage: ./bin/arena ask "question"   or add bin/ to PATH
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m arena "$@"
